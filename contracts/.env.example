# Foundry reads contracts/.env automatically. Copy this file to contracts/.env.
# Never put a private key here — the deploy signer comes from a foundry keystore
# account (`cast wallet import suiteas-deployer --interactive`). See docs/DEPLOY.md.

# --- Required to deploy ---

# Fuji RPC. Backs the `fuji` alias in foundry.toml.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# The ERC-20 koha settles in. Fuji USDC is the temporary fallback; replace with
# the dNZD address once New Money supplies it.
SETTLEMENT_TOKEN=0x5425890298aed601595a70AB815c96711a31Bc65

# Owner / oracle wallet. Owns Suite + AccessPass and is the only caller of
# distribute(). Public address only.
SUITE_OWNER=0xa7Dd13442d45450BE26843f6941B659555116bf1

# --- Optional, for the split (script/Distribute.s.sol) ---

# Deployed Suite. Unset = read it from deployments/<chainId>.json.
SUITE_ADDRESS=

# Seeded usage file, relative to contracts/. Unset = script/usage.example.json.
USAGE_FILE=

# Cap what this period splits, in the settlement token's atomic units.
# Unset or 0 = split the whole pool. Useful so the live counter keeps a balance.
DISTRIBUTE_MAX=
