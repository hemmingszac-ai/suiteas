# Web app environment. Copy to apps/web/.env.local and fill in.
# Never commit .env.local. Never put a secret in a NEXT_PUBLIC_* variable.
# Contract deployment has its own file — see contracts/.env.example.

# =============================================================================
# REQUIRED
# =============================================================================

# --- Privy (login + embedded wallets) ---
# From dashboard.privy.io -> your app -> Settings. Public, not a secret, so the
# real value is committed here to save setup time.
# Also add http://localhost:3000 AND the live Vercel URL to allowed origins.
NEXT_PUBLIC_PRIVY_APP_ID=cmrzbm07300en0djt6hnvzj5x

# --- Chain ---
# Avalanche Fuji testnet. Never mainnet.
NEXT_PUBLIC_CHAIN_ID=43113

# =============================================================================
# OPTIONAL
# =============================================================================

# Custom RPC. Falls back to the public Fuji RPC when empty.
NEXT_PUBLIC_FUJI_RPC_URL=

# WalletConnect project id, from cloud.walletconnect.com. Only needed for
# Core mobile / WalletConnect; injected-wallet and email login work without it.
NEXT_PUBLIC_WALLETCONNECT_ID=

# Where koha settles. Empty = the deployed Suite pool from addresses.json, which
# is now the correct live value — so leaving this empty is fine.
#
# On Fuji the pool is 0x9CFE88A4d8AEBF32F27dbBaaa335990dd70A2385. If you set this
# explicitly it MUST be that (or a newer Suite). Never a personal wallet, and never
# AccessPass/KohaRecord — those are ERC-721s with no way to move an ERC-20 out, so
# koha sent there is unrecoverable.
X402_PAY_TO=

# Per-request price for one metered koha call, as a money string. Default "$0.01".
# Ignored when the settlement token is configured explicitly below.
X402_PRICE=$0.01

# --- x402 facilitator ---
# Verifies and settles the payment. Empty = the x402.org testnet default, which
# does NOT settle Fuji, so set this for a real settlement.
#
# PayAI is what we use: it needs no API key and its /supported lists `exact` on
# avalanche-fuji (verified with a live request — see docs/X402.md).
#   curl -s https://facilitator.payai.network/supported
# Alternatives that also cover Fuji: https://facilitator.ultravioletadao.xyz,
# thirdweb (requires a paid-looking plan + secret key), or self-hosted x402-rs.
X402_FACILITATOR_URL=https://facilitator.payai.network

# Server secret, only if the chosen facilitator requires auth headers. PayAI does
# not, so this stays empty. Kept for a facilitator swap.
# Server-side only. Never commit it, never log it, never prefix it NEXT_PUBLIC_.
THIRDWEB_SECRET_KEY=

# Design-preview only. Renders auth-gated screens without a login and BYPASSES
# the auth guard. 1 = on. Must never be set in Vercel production.
NEXT_PUBLIC_PREVIEW_MOCK=

# =============================================================================
# PENDING — human inputs that do not exist yet. Leave empty until they arrive.
# =============================================================================

# --- Settlement token override (currently BLOCKED for dNZD) ---
#
# dNZD on Fuji has been inspected on-chain and its details are CONFIRMED
# (docs/DNZD.md):
#
#   address   0x99A22a5AD6B2fd7EefE512F49dc22336dEEdf877
#   decimals  6
#   EIP-712   name "dNZD", version "1"
#
# They are deliberately NOT filled in below, because dNZD does NOT implement
# EIP-3009 `transferWithAuthorization` — which is exactly what x402's exact-EVM
# scheme calls to settle. Setting these would produce valid-looking 402 quotes
# that fail at settlement, which is worse than not offering the token.
# It implements ERC-2612 `permit`, which is not a substitute: permit grants an
# allowance rather than moving tokens, so it still needs a second, gas-paying
# transaction.
#
# Fill these in only once the settlement token actually supports EIP-3009 —
# either dNZD upgraded (it is a UUPS proxy, so New Money can) or another token.
# ALL FIVE or NONE: partial configuration is a deliberate boot error, because
# settling in the wrong currency is worse than failing to start.
X402_SETTLEMENT_TOKEN_ADDRESS=
X402_SETTLEMENT_TOKEN_DECIMALS=
# The token's EIP-712 domain, exactly as the contract reports it. A mismatch
# means the payer signs something the token rejects at settlement. Read it from
# `eip712Domain()` / `DOMAIN_SEPARATOR()`, never from a guess.
X402_SETTLEMENT_TOKEN_EIP712_NAME=
X402_SETTLEMENT_TOKEN_EIP712_VERSION=
# Price in the token's ATOMIC UNITS, not dollars. Converting from X402_PRICE
# would invent an NZD/USD exchange rate, so it is a separate human input.
X402_PRICE_ATOMIC=

# Authorisation standard the rail relays. Only "eip3009" can settle over x402.
# "eip2612" is a recognised value but is rejected on purpose — see above.
X402_SETTLEMENT_AUTHORIZATION=eip3009
