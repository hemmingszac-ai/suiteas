# Copy to .env.local and fill in. Never commit .env.local.

# --- Privy (login + embedded wallets) ---
# From dashboard.privy.io -> your app -> Settings
NEXT_PUBLIC_PRIVY_APP_ID=cmrzbm07300en0djt6hnvzj5x

# --- Chain ---
# Avalanche Fuji testnet. Do not change to mainnet.
NEXT_PUBLIC_CHAIN_ID=43113
# Optional custom RPC. Falls back to the public Fuji RPC if empty.
NEXT_PUBLIC_FUJI_RPC_URL=

# --- WalletConnect (needed for Core mobile / WalletConnect option) ---
# From cloud.walletconnect.com. Optional for injected-only local testing.
NEXT_PUBLIC_WALLETCONNECT_ID=

# --- x402 (server payment middleware) ---
# Where koha settles. Leave empty to use the deployed Suite pool from
# addresses.json; set to a dev wallet to smoke-test before the contract exists.
X402_PAY_TO=
# Facilitator that verifies + settles on Fuji: thirdweb/x402's facilitator()
# builds it from these two (see lib/x402.ts) — no facilitator URL needed.
# THIRDWEB_SECRET_KEY: dashboard.thirdweb.com -> Settings -> API Keys.
# THIRDWEB_SERVER_WALLET_ADDRESS: Engine/Server Wallets -> create one, fund
#   with Fuji AVAX (it pays gas to sponsor gasless settlement).
# Both empty -> x402-next's default facilitator (x402.org, testnet, likely not
# Fuji) — fine to exercise the 402 flow, not for a real settlement.
THIRDWEB_SECRET_KEY=
THIRDWEB_SERVER_WALLET_ADDRESS=
# Per-request koha price. Default "$0.01".
X402_PRICE=

# --- Widget CORS (/api/pay — the embeddable SuiteasPayModal's endpoint) ---
# Origin(s) allowed to call it cross-origin from a third-party HTML page.
# "*" is fine for a public priced resource / hackathon demo.
X402_WIDGET_ALLOWED_ORIGIN=*
